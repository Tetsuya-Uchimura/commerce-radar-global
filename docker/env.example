# Copy to .env.docker.local at the repository root; never overwrite .env.
# Leave unused integrations blank. No buyer email/password belongs here.
CLIENT_ID=
CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CHANNEL3_API_KEY=

# Optional budgets/limits; default keys are independently optional.
ANALYSIS_AUTORUN=true
PRODUCT_SEARCH_MAX_PER_MINUTE=6
PRODUCT_SEARCH_MAX_PER_DAY=60
# APP_URL, DATABASE_URL, DEMO_MODE and SANDBOX_URL are fixed in compose.yaml.
