# Default-deny context. Git ignore rules do NOT protect Docker build contexts.
**
!requirements-lock.txt
!backend/
!backend/*.py
!backend/merchant_access.json
!backend/fixtures/
!backend/fixtures/*.json
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!docker/
!docker/backend.Dockerfile
!docker/frontend.Dockerfile
!docker/nginx.conf
# Defense in depth even if an allowed source directory gains local artifacts.
**/.env
**/.env.*
**/*.env
**/*.local
**/.npmrc
**/.git/**
**/.venv/**
**/node_modules/**
**/dist/**
**/__pycache__/**
**/*.pyc
**/*.db*
**/*.sqlite*
**/*.zip
**/*.log
**/.paypal-order*
**/.cache/**
**/.verification/**
**/demo-video/**
