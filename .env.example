# Optional Sandbox REST app credentials. Leave blank until configured.
CLIENT_ID=
CLIENT_SECRET=
SANDBOX_URL=https://api-m.sandbox.paypal.com

# Optional: explanations fall back to labelled statistical templates without both.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Local demo only. Do not expose this server to the public Internet.
DEMO_MODE=true
APP_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/global_radar.db
# Optional fixed synthetic reference date; blank uses the execution date.
DEMO_DATE=
ANALYSIS_AUTORUN=true
ASSUMED_CONVERSION_PERCENT=3.5
# Optional JSON overrides; relative weights are normalized by their sum.
SCORING_WEIGHTS_JSON={"interest":45,"cost":0,"fx":35,"novelty":10,"availability":10,"budget":0}

# Optional structured physical-product search. Server-only; obtain from Channel3 dashboard.
CHANNEL3_API_KEY=

# Automatic product search: actual provider attempts per persona; cache hits are free.
PRODUCT_SEARCH_MAX_PER_MINUTE=6
PRODUCT_SEARCH_MAX_PER_DAY=60

# Real-product FX-backed ranking. Separate from fictional catalog weights above.
FX_RECOMMENDATION_WEIGHTS_JSON={"interest":45,"fx":35,"novelty":10,"evidence":10}

# Shopping strategy UX thresholds, not universal economic/savings rules.
STRATEGY_NEUTRAL_PERCENT=0.5
STRATEGY_MEANINGFUL_PERCENT=1
STRATEGY_MINIMUM_DIFFERENCE_USD=1
STRATEGY_MINIMUM_INTEREST=40
